<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WANUtility.GomoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">

    <ScrollViewer>
        <!-- A star column keeps the full width while the details are hidden, so Refresh does not move. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="760" />
            </Grid.ColumnDefinitions>
            <StackPanel Padding="24,16,24,24" Spacing="12">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="GOMO" Style="{StaticResource TitleTextBlockStyle}" />
                    <ProgressRing x:Name="Busy" Grid.Column="1" IsActive="False" Width="16" Height="16" />
                    <Button x:Name="RefreshButton" Grid.Column="2" AutomationProperties.Name="Refresh" Click="RefreshButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBlock x:Name="StatusLine" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                <InfoBar x:Name="UnavailableBar" Severity="Informational" IsClosable="False" Title="GOMO is not available"
                         Message="GOMO needs an AIS SIM, with Windows using the cellular connection for internet (not Wi-Fi or a VPN)." />
                <InfoBar x:Name="FailureBar" Severity="Error" IsClosable="False" Title="Could not load your GOMO account" />

                <StackPanel x:Name="Details" Spacing="12" Visibility="Collapsed">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Data remaining" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="DataRemaining" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="DataMaximum" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Calls remaining" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="CallsRemaining" Style="{StaticResource SubtitleTextBlockStyle}" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="CallsMaximum" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Packages" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" />
                    <StackPanel x:Name="Packages" Spacing="8" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
